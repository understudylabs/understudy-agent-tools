{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "understudy.experiment-spec.v1"
    },
    "experiment_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "workflow_status": {
      "type": "string",
      "enum": [
        "pending",
        "running",
        "completed",
        "failed",
        "cancelled",
        "paused"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "started_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "result": {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "understudy.experiment-result.v1"
        },
        "experiment_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "state": {
          "type": "string",
          "enum": [
            "succeeded",
            "failed",
            "cancelled",
            "holdout_locked"
          ]
        },
        "verifier_environment": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "verifier_revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "split_manifest_refs": {
          "type": "object",
          "properties": {
            "train": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            "dev": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            "holdout": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            }
          },
          "required": [
            "train",
            "dev",
            "holdout"
          ],
          "additionalProperties": false
        },
        "split_manifest_sha256": {
          "type": "object",
          "properties": {
            "train": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "dev": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "holdout": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "train",
            "dev",
            "holdout"
          ],
          "additionalProperties": false
        },
        "baseline_metrics": {
          "anyOf": [
            {
              "type": "object",
              "propertyNames": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "additionalProperties": {
                "type": "number"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "optimized_metrics": {
          "anyOf": [
            {
              "type": "object",
              "propertyNames": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "additionalProperties": {
                "type": "number"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "holdout_executed": {
          "type": "boolean"
        },
        "holdout_clean": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "budget_usd": {
          "type": "number",
          "minimum": 0
        },
        "usage": {
          "type": "object",
          "properties": {
            "evidence_scope": {
              "type": "string",
              "enum": [
                "run_exclusive",
                "account_window",
                "unknown"
              ]
            },
            "requests": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            },
            "input_tokens": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            },
            "output_tokens": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            },
            "actual_usd": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ]
            },
            "estimated_usd": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ]
            },
            "upper_bound_usd": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ]
            },
            "observed_at": {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
            }
          },
          "required": [
            "evidence_scope",
            "requests",
            "input_tokens",
            "output_tokens",
            "actual_usd",
            "estimated_usd",
            "upper_bound_usd",
            "observed_at"
          ],
          "additionalProperties": false
        },
        "request_isolation_proven": {
          "type": "boolean"
        },
        "quality_evidence": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "not_measured",
                "measured",
                "invalidated_pending_calibration",
                "invalidated_quarantined",
                "calibrated"
              ]
            },
            "reason": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1000
                },
                {
                  "type": "null"
                }
              ]
            },
            "required_calibration": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500
                },
                {
                  "type": "null"
                }
              ]
            },
            "calibration_artifact_refs": {
              "maxItems": 32,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              }
            }
          },
          "required": [
            "status",
            "reason",
            "required_calibration",
            "calibration_artifact_refs"
          ],
          "additionalProperties": false
        },
        "failure_clusters": {
          "maxItems": 256,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "cluster": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240
              },
              "count": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "artifact_refs": {
                "default": [],
                "maxItems": 32,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1024
                }
              }
            },
            "required": [
              "cluster",
              "count"
            ],
            "additionalProperties": false
          }
        },
        "cancellation_receipts": {
          "maxItems": 128,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "job": {
                "type": "object",
                "properties": {
                  "executor": {
                    "type": "string",
                    "enum": [
                      "modal",
                      "wafer",
                      "fireworks",
                      "spark",
                      "fixture"
                    ]
                  },
                  "job_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 500
                  },
                  "idempotency_key": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 500
                  },
                  "submitted_at": {
                    "type": "string",
                    "format": "date-time",
                    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
                  }
                },
                "required": [
                  "executor",
                  "job_id",
                  "idempotency_key",
                  "submitted_at"
                ],
                "additionalProperties": false
              },
              "disposition": {
                "type": "string",
                "enum": [
                  "cancelled",
                  "already_terminal",
                  "not_found"
                ]
              },
              "observed_at": {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
              }
            },
            "required": [
              "job",
              "disposition",
              "observed_at"
            ],
            "additionalProperties": false
          }
        },
        "artifact_refs": {
          "maxItems": 512,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        },
        "claim_boundary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      },
      "required": [
        "schema_version",
        "experiment_id",
        "state",
        "verifier_environment",
        "verifier_revision",
        "split_manifest_refs",
        "split_manifest_sha256",
        "baseline_metrics",
        "optimized_metrics",
        "holdout_executed",
        "holdout_clean",
        "budget_usd",
        "usage",
        "request_isolation_proven",
        "quality_evidence",
        "failure_clusters",
        "cancellation_receipts",
        "artifact_refs",
        "claim_boundary"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "experiment_id",
    "workflow_status",
    "created_at"
  ],
  "additionalProperties": false,
  "$id": "https://understudylabs.com/schemas/understudy-train-v1/experiment-run-status-response.json"
}
