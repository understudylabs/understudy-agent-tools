        "role": "assistant"
      },
      {
        "content": "{\"drafts\":{\"d-1\":{\"status\":\"draft\",\"subject\":\"Old quarterly review\",\"to\":\"ruth.teitelbaum@example.test\"},\"d-2\":{\"status\":\"draft\",\"subject\":\"Quarterly review\",\"to\":\"katherine.johnson@example.test\"}},\"status\":200}",
        "role": "tool"
      },
      {
        "content": "{\"tool\":\"api_fetch\",\"arguments\":{\"method\":\"PATCH\",\"url\":\"/mail/drafts/d-1\",\"body\":{\"status\":\"discarded\"}}}",
        "role": "assistant"
      },
      {
        "content": "{\"draft\":{\"status\":\"discarded\",\"subject\":\"Old quarterly review\",\"to\":\"ruth.teitelbaum@example.test\"},\"status\":200}",
