{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Understudy",
  "version": "0.3.31",
  "identifier": "com.homescreen.app",
  "build": {
    "beforeDevCommand": "node ../../scripts/build-desktop-cli.mjs && bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "node ../../scripts/build-desktop-cli.mjs && bun run build",
    "frontendDist": "../out"
  },
  "app": {
    "windows": [
      {
        "title": "Understudy",
        "width": 1180,
        "height": 820,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 17,
          "y": 25
        },
        "acceptFirstMouse": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERBMTQ1NDRFRDI5NUExNUYKUldSZm9aWFNUbFFVMm5scWwwSHhOaWRpYlNJZVVKMGxSaDgybDUyUHRYOVU2aDhocXlVWlpYdXcK",
      "endpoints": [
        "https://github.com/understudylabs/understudy-agent-tools/releases/latest/download/latest.json"
      ]
    }
  }
}
