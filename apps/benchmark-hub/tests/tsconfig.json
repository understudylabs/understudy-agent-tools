{
  "compilerOptions": {
    "module": "commonjs",
    "target": "es2022",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": ".build",
    "rootDir": "..",
    "types": ["node"],
    "noEmitOnError": true
  },
  "include": [
    "../lib/types.ts",
    "../lib/benchmark-core.ts",
    "../lib/scores.ts",
    "../lib/data-core.ts",
    "../app/api/flags/route.ts",
    "../app/api/reviews/route.ts",
    "../app/api/captures/route.ts",
    "../lib/trace-viewer-core.ts",
    "../app/api/trace-viewer/route.ts",
    "../lib/trajectory-core.ts",
    "../app/api/rollouts/route.ts",
    "../lib/replay-core.ts",
    "../app/api/replay/route.ts",
    "../lib/runs-core.ts",
    "../app/api/runs/route.ts",
    "../app/api/runs/live/route.ts"
  ]
}
