{
  "name": "@understudylabs/understudy-agent-tools",
  "version": "0.1.0",
  "description": "Public Understudy agent tools CLI and skill library.",
  "type": "module",
  "bin": {
    "understudy": "dist/bin.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "skills",
    "cookbook",
    "docs",
    "vendor",
    "README.md",
    "AGENTS.md",
    "LICENSE",
    "!**/__pycache__",
    "!**/*.pyc",
    "!**/*.py"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "package:smoke": "node scripts/package-smoke.mjs",
    "cookbook:validate": "node scripts/validate-cookbook.mjs",
    "skills:validate": "node scripts/validate-public-skills.mjs --repo",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "check": "npm run build && npm run typecheck && npm test && npm run skills:validate && npm run cookbook:validate && npm run package:smoke"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.4.3",
    "commander": "^14.0.3",
    "kleur": "^4.1.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20.6.0"
  },
  "license": "MIT"
}
