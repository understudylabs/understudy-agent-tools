{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "executor": {
      "type": "string",
      "enum": [
        "modal",
        "wafer",
        "fireworks",
        "spark",
        "fixture"
      ]
    },
    "job_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "submitted_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    }
  },
  "required": [
    "executor",
    "job_id",
    "idempotency_key",
    "submitted_at"
  ],
  "additionalProperties": false,
  "$id": "https://understudylabs.com/schemas/understudy-train-v1/experiment-executor-job-ref.json"
}
