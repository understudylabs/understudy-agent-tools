{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://understudylabs.com/schemas/understudy.adapter_promotion_decision.v1.schema.json",
  "title": "understudy.adapter_promotion_decision.v1",
  "type": "object",
  "required": ["schema_version", "candidate", "evaluated_at", "policy", "checks", "decision", "idempotency_key", "inputs"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "understudy.adapter_promotion_decision.v1" },
    "candidate": { "type": "string", "minLength": 1 },
    "evaluated_at": { "type": "string", "format": "date-time" },
    "policy": { "$ref": "understudy.adapter_portfolio_registry.v1.schema.json#/$defs/policy" },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["check", "status", "detail"],
        "additionalProperties": false,
        "properties": {
          "check": { "enum": ["status", "dev_pass", "holdout_pass", "holdout_sealed", "no_forgetting"] },
          "status": { "enum": ["pass", "fail", "missing_evidence"] },
          "detail": { "type": "string", "minLength": 1 }
        }
      }
    },
    "decision": { "enum": ["promote", "blocked"] },
    "holdout_executed": { "type": "boolean" },
    "holdout_clean": { "type": ["boolean", "null"] },
    "request_isolation_proven": { "type": ["boolean", "null"] },
    "quality_evidence": { "$ref": "#/$defs/quality_evidence" },
    "failure_clusters": {
      "type": "array",
      "maxItems": 256,
      "items": { "$ref": "#/$defs/failure_cluster" }
    },
    "artifact_refs": {
      "type": "array",
      "maxItems": 512,
      "items": { "$ref": "understudy.adapter_portfolio_registry.v1.schema.json#/$defs/artifact_ref" }
    },
    "claim_boundary": { "type": "string", "minLength": 1, "maxLength": 2000 }
    ,
    "idempotency_key": { "type": "string", "minLength": 1, "maxLength": 500 },
    "inputs": {
      "type": "object",
      "required": ["registry", "candidate_holdout", "evidence_ids"],
      "additionalProperties": false,
      "properties": {
        "registry": { "$ref": "understudy.adapter_portfolio_registry.v1.schema.json#/$defs/artifact_ref" },
        "candidate_holdout": {
          "anyOf": [
            { "type": "null" },
            { "$ref": "understudy.adapter_portfolio_registry.v1.schema.json#/$defs/candidate_holdout_artifact" }
          ]
        },
        "evidence_ids": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "quality_evidence": {
      "type": "object",
      "required": ["status", "reason", "required_calibration", "calibration_artifact_refs"],
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "not_measured",
            "measured",
            "invalidated_pending_calibration",
            "invalidated_quarantined",
            "calibrated"
          ]
        },
        "reason": { "type": ["string", "null"], "maxLength": 1000 },
        "required_calibration": { "type": ["string", "null"], "maxLength": 500 },
        "calibration_artifact_refs": {
          "type": "array",
          "maxItems": 32,
          "items": { "$ref": "understudy.adapter_portfolio_registry.v1.schema.json#/$defs/artifact_ref" }
        }
      }
    },
    "failure_cluster": {
      "type": "object",
      "required": ["cluster", "count", "artifact_refs"],
      "additionalProperties": false,
      "properties": {
        "cluster": { "type": "string", "minLength": 1, "maxLength": 240 },
        "count": { "type": "integer", "minimum": 0 },
        "artifact_refs": {
          "type": "array",
          "maxItems": 32,
          "items": { "$ref": "understudy.adapter_portfolio_registry.v1.schema.json#/$defs/artifact_ref" }
        }
      }
    }
  }
}
