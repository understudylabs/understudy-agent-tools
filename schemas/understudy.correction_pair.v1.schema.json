{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.understudylabs.com/understudy.correction_pair.v1.schema.json",
  "title": "Understudy supervision correction pair v1",
  "type": "object",
  "required": [
    "schema_version",
    "event_schema",
    "runtime_id",
    "session_id",
    "run_id",
    "marker_id",
    "verdict_event_id",
    "verdict_sequence",
    "captured_at",
    "user_request",
    "student",
    "supervisor",
    "continuation",
    "tool_results",
    "run_usage",
    "human_judgment"
  ],
  "properties": {
    "schema_version": {
      "const": "understudy.correction_pair.v1"
    },
    "event_schema": {
      "const": "understudy-conversation-runtime-event-v1"
    },
    "runtime_id": {
      "type": "string",
      "minLength": 1
    },
    "session_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "marker_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "verdict_event_id": {
      "type": "string",
      "minLength": 1
    },
    "verdict_sequence": {
      "type": "integer",
      "minimum": 0
    },
    "boundary_ordinal": {
      "type": ["integer", "null"],
      "minimum": 0
    },
    "decision_phase": {
      "type": ["string", "null"],
      "enum": ["streaming", "final", null]
    },
    "captured_at": {
      "type": "string",
      "minLength": 1
    },
    "user_request": {
      "type": "string"
    },
    "student": {
      "type": "object",
      "required": ["model", "status", "partial_output", "intervention_at_chars"],
      "properties": {
        "model": { "type": "string", "minLength": 1 },
        "status": { "enum": ["interrupted", "nudged"] },
        "partial_output": { "type": "string", "minLength": 1 },
        "intervention_at_chars": { "type": ["integer", "null"], "minimum": 0 }
      },
      "additionalProperties": false
    },
    "supervisor": {
      "type": "object",
      "required": ["action", "source", "reason", "raw", "probabilities", "probability_kind"],
      "properties": {
        "action": { "enum": ["interrupt", "nudge"] },
        "source": { "enum": ["model", "policy", "human"] },
        "reason": { "type": "string", "minLength": 1 },
        "raw": { "type": ["string", "null"] },
        "probabilities": { "type": ["object", "null"], "additionalProperties": { "type": "number" } },
        "probability_kind": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "continuation": {
      "type": "object",
      "required": ["model", "authorship", "output"],
      "properties": {
        "model": { "type": "string", "minLength": 1 },
        "authorship": { "enum": ["teacher_continuation", "small"] },
        "output": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "tool_results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "raw_args", "parsed_ok", "validation_error", "result", "result_ok"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "raw_args": { "type": "string" },
          "parsed_ok": { "type": "boolean" },
          "validation_error": { "type": ["string", "null"] },
          "result": { "type": "string" },
          "result_ok": { "type": "boolean" }
        }
      }
    },
    "run_usage": {
      "type": "object",
      "required": ["scope", "student", "supervisor", "teacher", "attribution_complete", "incomplete_roles"],
      "properties": {
        "scope": { "const": "entire_canonical_run" },
        "student": { "$ref": "#/$defs/role_usage" },
        "supervisor": { "$ref": "#/$defs/role_usage" },
        "teacher": { "$ref": "#/$defs/role_usage" },
        "attribution_complete": { "type": "boolean" },
        "incomplete_roles": {
          "type": "array",
          "items": { "enum": ["student", "supervisor", "teacher"] },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "human_judgment": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["helpful", "correct_action", "justification", "created_at"],
          "properties": {
            "helpful": { "type": "boolean" },
            "correct_action": { "type": ["string", "null"], "enum": ["continue", "nudge", "interrupt", "stop", null] },
            "justification": { "type": ["string", "null"] },
            "created_at": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        }
      ]
    }
  },
  "$defs": {
    "role_usage": {
      "type": "object",
      "required": [
        "event_count",
        "input_tokens",
        "output_tokens",
        "reasoning_tokens",
        "cached_input_tokens",
        "total_tokens",
        "models",
        "attribution"
      ],
      "properties": {
        "event_count": { "type": "integer", "minimum": 0 },
        "input_tokens": { "type": "integer", "minimum": 0 },
        "output_tokens": { "type": "integer", "minimum": 0 },
        "reasoning_tokens": { "type": "integer", "minimum": 0 },
        "cached_input_tokens": { "type": "integer", "minimum": 0 },
        "total_tokens": { "type": "integer", "minimum": 0 },
        "models": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "attribution": { "enum": ["exact", "missing", "incomplete", "not_applicable"] }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
