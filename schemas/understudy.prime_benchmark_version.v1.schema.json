{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://understudylabs.com/schemas/understudy.prime_benchmark_version.v1.schema.json",
  "title": "understudy.prime_benchmark_version.v1",
  "type": "object",
  "required": ["schema_version", "benchmark_id", "status", "manifest_sha256", "rows_sha256", "incumbent_model", "task_count", "note", "created_at"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "understudy.prime_benchmark_version.v1"},
    "benchmark_id": {"type": "string", "minLength": 1},
    "status": {"const": "frozen"},
    "manifest_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "rows_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "verifier_version": {"type": ["string", "null"]},
    "incumbent_model": {"type": "string", "minLength": 1},
    "task_count": {"type": "integer", "minimum": 1},
    "note": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "minLength": 1}
  }
}
