{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://understudylabs.com/schemas/understudy.gepa_controller.v1.schema.json",
  "title": "understudy.gepa_controller.v1",
  "description": "Provider-neutral train/dev GEPA controller input. It has no holdout or promotion path.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "workload_id", "source_binding_sha256", "verifier_calibration_sha256", "benchmark_sha256", "split_manifest_sha256", "train_sha256", "dev_sha256", "holdout_sha256", "train_rows", "dev_rows", "seed", "seed_dev_quality", "seed_family_scores", "protected_families", "target_score", "fuse"],
  "properties": {
    "schema_version": { "const": "understudy.gepa_controller.v1" },
    "run_id": { "$ref": "#/$defs/id" },
    "workload_id": { "$ref": "#/$defs/id" },
    "source_binding_sha256": { "$ref": "#/$defs/sha256" },
    "verifier_calibration_sha256": { "$ref": "#/$defs/sha256" },
    "benchmark_sha256": { "$ref": "#/$defs/sha256" },
    "split_manifest_sha256": { "$ref": "#/$defs/sha256" },
    "train_sha256": { "$ref": "#/$defs/sha256" },
    "dev_sha256": { "$ref": "#/$defs/sha256" },
    "holdout_sha256": { "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
    "train_rows": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/train_row" } },
    "dev_rows": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/dev_row" } },
    "seed": { "$ref": "#/$defs/candidate" },
    "seed_dev_quality": { "$ref": "#/$defs/score" },
    "seed_family_scores": { "type": "object", "minProperties": 1, "additionalProperties": { "$ref": "#/$defs/score" } },
    "protected_families": { "type": "array", "items": { "$ref": "#/$defs/protected_family" } },
    "target_score": { "$ref": "#/$defs/score" },
    "fuse": { "$ref": "#/$defs/fuse" }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1 },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "score": { "type": "number", "minimum": 0, "maximum": 1 },
    "candidate": { "type": "object", "additionalProperties": false, "required": ["candidate_id", "candidate_sha256"], "properties": { "candidate_id": { "$ref": "#/$defs/id" }, "candidate_sha256": { "$ref": "#/$defs/sha256" } } },
    "row": { "type": "object", "additionalProperties": false, "required": ["id", "split", "family", "frozen"], "properties": { "id": { "$ref": "#/$defs/id" }, "split": { "enum": ["train", "dev"] }, "family": { "$ref": "#/$defs/id" }, "frozen": { "const": false } } },
    "train_row": { "allOf": [{ "$ref": "#/$defs/row" }, { "properties": { "split": { "const": "train" } } }] },
    "dev_row": { "allOf": [{ "$ref": "#/$defs/row" }, { "properties": { "split": { "const": "dev" } } }] },
    "protected_family": { "type": "object", "additionalProperties": false, "required": ["family", "target_score", "max_regression"], "properties": { "family": { "$ref": "#/$defs/id" }, "target_score": { "$ref": "#/$defs/score" }, "max_regression": { "$ref": "#/$defs/score" } } },
    "fuse": { "type": "object", "additionalProperties": false, "required": ["max_concurrency", "max_metric_calls", "max_spend_usd", "max_cost_per_call_usd", "max_wallclock_ms", "max_episodes", "max_reflections"], "properties": { "max_concurrency": { "type": "integer", "minimum": 1 }, "max_metric_calls": { "type": "integer", "minimum": 1 }, "max_spend_usd": { "type": "number", "minimum": 0 }, "max_cost_per_call_usd": { "type": "number", "exclusiveMinimum": 0 }, "max_wallclock_ms": { "type": "integer", "minimum": 1 }, "max_episodes": { "type": "integer", "minimum": 1 }, "max_reflections": { "type": "integer", "minimum": 0 } } }
  }
}
