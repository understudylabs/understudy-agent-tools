{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.understudylabs.com/understudy.supervision_metrics.v1.schema.json",
  "title": "Understudy supervision metrics v1",
  "type": "object",
  "required": [
    "schema_version",
    "objective",
    "review_filter",
    "exported_pair_count",
    "complete_pair_count",
    "reviewed_pair_count",
    "pending_pair_count",
    "incomplete_intervention_count",
    "truncated_intervention_count",
    "invalid_journal_count",
    "missing_journal_count",
    "truncated_journal_count",
    "supervised_run_count",
    "verdict_count",
    "continue_count",
    "interrupt_count",
    "nudge_count",
    "stop_count",
    "labeled_intervention_count",
    "correct_intervention_count",
    "intervention_precision",
    "labeled_nudge_count",
    "false_positive_nudge_count",
    "false_positive_nudge_rate",
    "usage"
  ],
  "properties": {
    "schema_version": { "const": "understudy.supervision_metrics.v1" },
    "objective": { "const": "maximize_correct_interventions_not_minimize_rejections" },
    "review_filter": { "enum": ["all", "reviewed_only"] },
    "exported_pair_count": { "type": "integer", "minimum": 0 },
    "complete_pair_count": { "type": "integer", "minimum": 0 },
    "reviewed_pair_count": { "type": "integer", "minimum": 0 },
    "pending_pair_count": { "type": "integer", "minimum": 0 },
    "incomplete_intervention_count": { "type": "integer", "minimum": 0 },
    "truncated_intervention_count": { "type": "integer", "minimum": 0 },
    "invalid_journal_count": { "type": "integer", "minimum": 0 },
    "missing_journal_count": { "type": "integer", "minimum": 0 },
    "truncated_journal_count": { "type": "integer", "minimum": 0 },
    "supervised_run_count": { "type": "integer", "minimum": 0 },
    "verdict_count": { "type": "integer", "minimum": 0 },
    "continue_count": { "type": "integer", "minimum": 0 },
    "interrupt_count": { "type": "integer", "minimum": 0 },
    "nudge_count": { "type": "integer", "minimum": 0 },
    "stop_count": { "type": "integer", "minimum": 0 },
    "labeled_intervention_count": { "type": "integer", "minimum": 0 },
    "correct_intervention_count": { "type": "integer", "minimum": 0 },
    "intervention_precision": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "labeled_nudge_count": { "type": "integer", "minimum": 0 },
    "false_positive_nudge_count": { "type": "integer", "minimum": 0 },
    "false_positive_nudge_rate": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "usage": {
      "type": "object",
      "required": [
        "eligible_run_count",
        "excluded_run_count",
        "student",
        "supervisor",
        "teacher",
        "small_model_output_share",
        "supervisor_token_overhead",
        "small_model_share_denominator",
        "supervisor_overhead_denominator"
      ],
      "properties": {
        "eligible_run_count": { "type": "integer", "minimum": 0 },
        "excluded_run_count": { "type": "integer", "minimum": 0 },
        "student": { "$ref": "understudy.correction_pair.v1.schema.json#/$defs/role_usage" },
        "supervisor": { "$ref": "understudy.correction_pair.v1.schema.json#/$defs/role_usage" },
        "teacher": { "$ref": "understudy.correction_pair.v1.schema.json#/$defs/role_usage" },
        "small_model_output_share": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "supervisor_token_overhead": { "type": ["number", "null"], "minimum": 0 },
        "small_model_share_denominator": { "const": "student_output_tokens_plus_teacher_output_tokens" },
        "supervisor_overhead_denominator": { "const": "student_total_tokens_plus_teacher_total_tokens" }
      },
      "additionalProperties": false
    },
    "correction_pairs": {
      "type": "object",
      "required": ["schema_version", "sha256", "row_count"],
      "properties": {
        "schema_version": { "const": "understudy.correction_pair.v1" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "row_count": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
