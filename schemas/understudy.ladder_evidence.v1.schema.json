{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://understudylabs.com/schemas/understudy.ladder_evidence.v1.schema.json",
  "title": "understudy.ladder_evidence.v1",
  "type": "object",
  "required": [
    "schema_version",
    "experiment_id",
    "workload",
    "incumbent",
    "candidates",
    "holdout",
    "saturation",
    "evidence_scope",
    "claim_boundary",
    "parser"
  ],
  "additionalProperties": true,
  "properties": {
    "schema_version": { "const": "understudy.ladder_evidence.v1" },
    "experiment_id": { "type": "string", "minLength": 1 },
    "workload": {
      "type": "object",
      "required": ["id", "description", "fixture_sha256"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "fixture_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "incumbent": {
      "type": "object",
      "required": ["provider", "model", "serving_contract"],
      "properties": {
        "provider": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 },
        "serving_contract": { "type": "string", "minLength": 1 }
      }
    },
    "candidates": { "type": "array", "items": { "type": "object" } },
    "holdout": {
      "type": "object",
      "required": ["status", "sha256"],
      "properties": {
        "status": { "enum": ["clean", "executed"] },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "saturation": { "type": "object", "required": ["fixture_sha256", "usable"] },
    "evidence_scope": { "enum": ["dev-only", "holdout"] },
    "claim_boundary": { "type": "string", "minLength": 1 },
    "parser": {
      "type": "object",
      "required": ["revision", "sha256"],
      "properties": {
        "revision": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    }
  }
}
